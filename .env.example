# Required: model used by all four trading agents
OPENAI_API_KEY=your_openai_api_key

# Required: financial-news web searches
TAVILY_API_KEY=your_tavily_api_key

# Required: live/end-of-day stock prices and market status
MASSIVE_API_KEY=your_massive_api_key

# Scheduler settings
# Agents run one at a time. With four agents and a 15-minute interval,
# each individual agent runs approximately once per hour.
RUN_BETWEEN_AGENTS_MINUTES=15
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false

# Optional provider keys. These are only needed if model_names in
# backend/trading_floor.py is changed to use the corresponding provider.
# DEEPSEEK_API_KEY=your_deepseek_api_key
# GEMINI_API_KEY=your_gemini_api_key
# GROK_API_KEY=your_grok_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key
